# =============================================================================
# MBOKDHE FASHION ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual API keys.
# =============================================================================

# 1. API Key untuk Shipping Cost (RajaOngkir Komerce / Starter)
NEXT_PUBLIC_RAJAONGKIR_API_KEY=your_rajaongkir_api_key_here
RAJAONGKIR_API_KEY=your_rajaongkir_api_key_here

# 2. API Key untuk Qrisly API (QRIS Generator)
QRISLY_API_KEY=your_qrisly_api_key_here

# 3. API Key untuk Payment API (Payment Gateway)
PAYMENT_API_KEY=your_payment_api_key_here

# SQLite Database Path
DATABASE_URL="file:./dev.db"
