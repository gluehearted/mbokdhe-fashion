generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Shop {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Customer {
  id                 String   @id // CUST ID generate otomatis (e.g. CST-260811-01)
  name               String   // NAMA PELANGGAN
  whatsapp           String   @unique // NO. WA
  domisili           String?  // DOMISILI
  shippingCost       Int      @default(0) // Ongkir
  courier            String?  // Ekspedisi
  addressDetail      String   // Detail Alamat
  behavioral         String?  // BEHAVIORAL ("Pelanggan Setia", "Pembeli Berulang", "Impulsif", "Pemburu Diskon")
  consumerType       String?  // TIPE KONSUMEN ("Eceran", "Reseller", "Dropshipper", "VIP")
  relationshipStatus String?  // STATUS HUBUNGAN ("Aktif", "Hangat", "Dingin", "Prospek Baru", "Berhenti")
  totalSpending      Int      @default(0) // TOTAL SPENDING
  totalTransactions  Int      @default(0) // TOTAL TRANSAKSI
  crisisStatus       String?  // STATUS KRISIS ("Normal", "Risiko Rendah", "Risiko Sedang", "Risiko Tinggi", "Daftar Hitam")
  createdAt          DateTime @default(now())
  orders             Order[]
}

model Order {
  id              String    @id @default(uuid())
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])
  status          String    @default("Menunggu") // "Menunggu", "DP", "Siap Packing", "Dikirim", "Dibatalkan"
  shippingCourier String?   // Ekspedisi
  shippingService String?   // Layanan
  shippingCost    Int       @default(0) // Ongkir
  totalWeightGram Int       @default(1000)
  dpAmount        Int       @default(0)
  dpForfeited     Boolean   @default(false)
  dpDate          DateTime?
  totalPrice      Int       @default(0)
  trackingNo      String?   // Nomor Resi Pengiriman
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]
}

model Product {
  id           String   @id
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id])
  shopId       String?
  shop         Shop?    @relation(fields: [shopId], references: [id])
  capitalPrice Int      @default(0)
  price        Int
  discount     Int      @default(0) // Diskon per tas (Rp)
  description  String   @default("") // Deskripsi Produk
  status       String   @default("Tersedia") // "Tersedia", "Dibooking", "Terjual"
  photoUrl     String
  createdAt    DateTime @default(now())
}
