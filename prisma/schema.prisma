generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model ShopConfig {
  id            String   @id @default("default")
  shopName      String   @default("Mbokdhe Fashion")
  senderName    String   @default("Admin Mbokdhe")
  senderPhone   String   @default("081234567890")
  province      String   @default("Jawa Barat")
  cityName      String   @default("Kabupaten Bogor")
  originCityId  Int      @default(54)
  district      String   @default("Sukaraja")
  subdistrict   String   @default("Cijujung")
  postalCode    String   @default("16710")
  addressDetail String   @default("Perum Kostrad Cijujung Permai Blok D.1")
  updatedAt     DateTime @updatedAt
}

model Shop {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Customer {
  id            String   @id @default(uuid())
  name          String
  whatsapp      String   @unique
  province      String?  // Provinsi (Misal: Riau)
  cityName      String?  // Kota/Kabupaten (Misal: Kota Pekanbaru)
  cityId        Int      // ID Kota dari RajaOngkir (Misal: 338)
  district      String?  // Kecamatan (Misal: Tampan)
  subdistrict   String?  // Kelurahan / Desa (Misal: Delima)
  postalCode    String?  // Kode Pos (Misal: 28289)
  addressDetail String   // Detail Jalan, RT/RW, No. Rumah
  createdAt     DateTime @default(now())
  orders        Order[]
}

model Order {
  id              String    @id @default(uuid())
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])
  status          String    // "Keep", "DP", "Siap_Packing", "Shipped", "Cancelled"
  shippingCourier String?   // "jne", "pos", "tiki"
  shippingService String?   // "REG", "OKE"
  shippingCost    Int       @default(0)
  totalWeightGram Int       @default(1000) // Total berat gramasi 1 orderan
  dpAmount        Int       @default(0)
  dpForfeited     Boolean   @default(false)
  dpDate          DateTime?
  totalPrice      Int       @default(0)
  trackingNo      String?   // Nomor Resi Pengiriman
  notes           String?   // Catatan tambahan / DP forfeit info
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]
}

model Product {
  id           String   @id // Dynamic ID Manual (Misal: T01, B12)
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id])
  shopOrigin   String
  capitalPrice Int      @default(0) // Harga Modal
  price        Int      // Harga Jual
  status       String   @default("Available") // "Available", "Booked", "Sold"
  photoUrl     String   // Path lokal (Misal: /uploads/T01.jpg)
  createdAt    DateTime @default(now())
}
